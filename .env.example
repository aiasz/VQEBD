# =============================================================================
# VQEBD — környezeti változók MINTA fájlja
# =============================================================================
#
#   MÁSOLD EZT `.env` NÉVRE, ÉS OTT TÖLTSD KI!
#
#       cp .env.example .env
#
#   A `.env` fájl a .gitignore-ban és a .dockerignore-ban is szerepel, így soha
#   nem kerül sem a repóba, sem az image rétegeibe. Ezt automatikus teszt őrzi:
#   tests/unit/test_secrets_hygiene.py
#
#   EBBE A FÁJLBA SOHA NE ÍRJ VALÓDI TOKENT.
# =============================================================================

# --- IBM Quantum (Fázis 2-től használatos) ----------------------------------
# A token az IBM Quantum Platform felületén generálható:
#   https://quantum.cloud.ibm.com/
# Csatorna: az `ibm_quantum` csatorna 2025 júliusában megszűnt; a támogatott
# értékek a qiskit-ibm-runtime 0.41.1-ben: ibm_quantum_platform, ibm_cloud
# (mérve: docs/testing/TR-000_spike.md, 1. kör / 11. lépés).
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
IBM_QUANTUM_INSTANCE=

# Az alapértelmezett backend neve valódi futtatáshoz (Fázis 2).
# Üresen hagyva a rendszer a legkevésbé terhelt, elérhető backendet választja.
IBM_BACKEND_NAME=

# --- Futtatási korlátok (kvótavédelem) --------------------------------------
# Biztonsági kapcsoló: `false` esetén a rendszer MEGTAGADJA a valódi QPU-ra
# küldést, akkor is, ha a konfiguráció azt kérné. Alapértelmezés: tiltva.
VQEBD_ALLOW_HARDWARE=false

# Maximum ennyi job küldhető egyetlen futtatás során valódi hardverre.
VQEBD_MAX_HARDWARE_JOBS=1

# --- Naplózás ----------------------------------------------------------------
VQEBD_LOG_LEVEL=INFO

# --- Determinizmus (ADR-0005) ------------------------------------------------
# Egyetlen mester-seed, amelyből a rendszer a többit determinisztikusan származtatja.
VQEBD_MASTER_SEED=20260922
