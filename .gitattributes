# VQEBD — sorvégek egységesítése.
# A fejlesztés Windowson is folyhat, a futtatás viszont mindig Linux-konténerben:
# a repóban ezért kizárólag LF sorvég lehet (R0.2 kockázat, phase_00.md).

* text=auto eol=lf

*.py     text eol=lf diff=python
*.md     text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.cff    text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Bináris fájlok — soha ne alakítsa át
*.png    binary
*.jpg    binary
*.pdf    binary
*.sqlite binary
*.parquet binary
