# ─────────────────────────────────────────────────────────────────────────────
# VQEBD — .gitignore
#
# Ez a fájl a helyi szabályok és a GitHub Python-sablonjának EGYESÍTETT
# változata (merge `a723700` után kézzel feloldva, 2026-09-22).
#
# FIGYELEM: a titkokra vonatkozó szabályokat (.env, *.token, stb.) automatikus
# teszt őrzi: tests/repo/test_secrets_hygiene.py. NE TÖRÖLD ŐKET.
# ─────────────────────────────────────────────────────────────────────────────

# --- Titkok ---------------------------------------------------------------
.env
.env.*
!.env.example
*.token
*.secret
*.pem
*.key
secrets/
.qiskit/
qiskit-ibm.json

# --- Futásidőben keletkező adat -------------------------------------------
# A KÖNYVTÁRAK megmaradnak (.gitkeep), csak a TARTALMUK van kizárva. Git nem tud
# fájlt visszaengedni egy kizárt könyvtárból, ezért `dir/*` és nem `dir/` a minta.
data/db/*
data/raw/*
data/exports/*
!data/db/.gitkeep
!data/raw/.gitkeep
!data/exports/.gitkeep
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# --- Byte-fordított / optimalizált fájlok ----------------------------------
__pycache__/
*.py[codz]
*$py.class

# --- C kiterjesztések ------------------------------------------------------
*.so

# --- Terjesztés / csomagolás -----------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- PyInstaller -----------------------------------------------------------
*.manifest
*.spec

# --- Telepítési naplók -----------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt

# --- Virtuális környezetek -------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# --- Tesztelés és lefedettség ----------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
nosetests.xml
.tox/
.nox/
.hypothesis/
.cache

# --- Jupyter és IPython ----------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# --- Dokumentációs építés --------------------------------------------------
docs/_build/
/site

# --- Csomagkezelők ---------------------------------------------------------
__pypackages__/
.pdm.toml
.pdm-python
.pdm-build/
poetry.toml
.ruff_cache/

# --- Docker ----------------------------------------------------------------
.docker/

# --- Szerkesztők és operációs rendszer --------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.spyderproject
.spyproject
.ropeproject

# --- Generált ábrák (a docs/figures/ csak a véglegeseket tartalmazza) -------
docs/figures/tmp/

# --- Streamlit -------------------------------------------------------------
.streamlit/secrets.toml

# --- Egyéb -----------------------------------------------------------------
celerybeat-schedule
celerybeat.pid
*.sage.py
.scrapy
.webassets-cache
instance/
.flaskenv
